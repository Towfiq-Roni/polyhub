{
  "name": "hub",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "// dev": "runs -r (all workspace packages); only apps/api exists so far, apps/web joins once it's scaffolded",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3",
    "typescript-eslint": "^8"
  },
  "//pnpm.overrides": "ponytail: multer 2.5.0 - remove when @nestjs/platform-express 11.x depends on multer >=2.5.0; js-yaml 5.5.0 - remove when @nestjs/swagger 11.x depends on js-yaml >=5.4.1; deepmerge-ts 8.0.2 - remove when @prisma/config 6.x depends on deepmerge-ts >=8",
  "pnpm": {
    "overrides": {
      "multer": "2.5.0",
      "js-yaml": "5.5.0",
      "deepmerge-ts": "8.0.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
