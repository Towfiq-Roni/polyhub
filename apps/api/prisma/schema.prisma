generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id       String @id @default(uuid())
  // Also protected by raw-SQL unique index users_email_lower_key ON users (lower(email)) (migration 20261026000000_users_email_lower_unique; invisible to Prisma, do not drop). App still lowercases (normalizeEmail).
  email    String @unique
  passwordHash String @map("password_hash")
  name     String
  status   Status @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // teamMemberId FK deferred until the TeamMember table exists (separate epic).
  userRoles UserRole[]
  sessions  Session[]
  loginAttempts LoginAttempt[]

  @@map("users")
}

// Failed-login state per (user, client IP) (DEC-115, #52). Written only by raw atomic
// upsert (sets updated_at = now()), hence no @updatedAt; Prisma callers must pass updatedAt.
model LoginAttempt {
  userId        String    @map("user_id")
  ip            String
  failedCount   Int       @map("failed_count")
  firstFailedAt DateTime  @map("first_failed_at")
  lockoutUntil  DateTime? @map("lockout_until")
  updatedAt     DateTime  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, ip])
  @@map("login_attempts")
}

model Role {
  id     String @id @default(uuid())
  name   String @unique
  status Status @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]

  @@map("roles")
}

// Per-device refresh-token revocation (DEC-078, supersedes Batch 10's stateless-only
// design). One row per login; its id is embedded as the `sid` claim in that login's
// refresh JWT. `logout()` revokes exactly this one row, leaving every other
// device's Session untouched — this is what makes revocation per-device, not global.
model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}
