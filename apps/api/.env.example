# Copy to .env and fill in real values. Never commit .env.
# See apps/api/src/config/env.validation.ts for the full validation schema.

# Postgres connection string (required, no default)
DATABASE_URL=

# JWT secrets (required, no default — app fails to boot loudly if unset)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes (SRS §3.7 / ADR-0012)
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

# Login lockout (SRS §3.7)
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_WINDOW_MINUTES=15

# SUPER_ADMIN bootstrap seed (required, no default — never hardcode credentials)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Refresh cookie `secure` flag — true in production (HTTPS), false in local dev
COOKIE_SECURE=false

# Web app origin for CORS (required, no default — must be explicit)
WEB_ORIGIN=

# API port
PORT=4000
