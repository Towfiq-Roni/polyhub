# Local dev Postgres (docker-compose.yml + docker-compose.dev.yml). Throwaway
# local-only values — never internet-reachable, fine to keep non-blank here.
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_dev_local_only
POSTGRES_DB=hub_dev
POSTGRES_PORT=5432

# apps/api/.env must point DATABASE_URL at this same container to match:
# DATABASE_URL=postgresql://hub:hub_dev_local_only@localhost:5432/hub_dev

# Containerized dev api (infra/docker-compose.dev.yml's `api` service reads
# this via env_file — NOT the same file as apps/api/.env, which host-run
# `pnpm dev`/`test:e2e` reads and keeps pointed at localhost). Throwaway
# local-only values, same precedent as the Postgres block above.
# DATABASE_URL below deliberately targets `postgres` (the Compose service DNS
# name), not `localhost` — both files coexist correctly for their consumers.
DATABASE_URL=postgresql://hub:hub_dev_local_only@postgres:5432/hub_dev
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_ACCESS_TTL=1d
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_REFRESH_TTL=7d
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_WINDOW_MINUTES=15
SUPER_ADMIN_EMAIL=admin@hub.dev
SUPER_ADMIN_PASSWORD=dev_super_admin_password_change_me
COOKIE_SECURE=false
PORT=4000
WEB_ORIGIN=https://localhost:8443
